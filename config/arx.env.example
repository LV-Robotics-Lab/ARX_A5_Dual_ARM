# Copy this file to config/arx.local.env on the robot workstation.
# Values are non-secret hardware identity and runtime configuration.

ARX_LEFT_CAN=can1
ARX_RIGHT_CAN=can3
ARX_URDF_NAME=a5.urdf

# Stable physical-camera serial to logical-mount binding.
ARX_CAM_TOP_SERIAL=f1470834
ARX_CAM_LEFT_WRIST_SERIAL=260322270692
ARX_CAM_RIGHT_WRIST_SERIAL=260322273625

ARX_VENDOR_ROOT="$HOME/workspace/arx_wrapper"
ARX_DATA_ROOT="$HOME/workspace/raw_data"
ARX_TASK_NAME=egg_to_bowl
ARX_ARM_PUBLISH_HZ=60
ARX_CAMERA_PUBLISH_HZ=30

# A5 gripper convention: 0 is closed and negative values open the gripper.
ARX_GRIPPER_MIN=-3.35
ARX_GRIPPER_MAX=0.0
