# ============ A5 SDK 编译产物 ============
# 编译生成的目录
A5/build/
A5/bimanual/api/build/

# 编译生成的动态库和 Python 扩展
A5/bimanual/api/*.so
A5/bimanual/api/arx_r5_python/*.so
A5/bimanual/api/arx_r5_src/*.so

# 例外：上游 ARX 提供的预编译二进制依赖（build.sh 需要它们）
!A5/bimanual/lib/libkinematic_solver.so
!A5/bimanual/lib/arx_r5_src/libarx_r5a_src.so

